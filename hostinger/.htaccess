# Neutral Politics — Hostinger / Apache
# Copied into the web root (out/ / public_html) at build time. Do not put secrets here.

Options +FollowSymLinks -Indexes -MultiViews
DirectoryIndex index.html index.php
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Apex host -> https://www, stripping a trailing slash (same as the Pages Function).
  RewriteCond %{HTTP_HOST} ^neutralpolitics\.in$ [NC]
  RewriteRule ^$ https://www.neutralpolitics.in/ [R=308,L]
  RewriteCond %{HTTP_HOST} ^neutralpolitics\.in$ [NC]
  RewriteRule ^(.+?)/+$ https://www.neutralpolitics.in/$1 [R=308,L]
  RewriteCond %{HTTP_HOST} ^neutralpolitics\.in$ [NC]
  RewriteRule ^(.+)$ https://www.neutralpolitics.in/$1 [R=308,L]

  # HTTPS only on the live domain. Preview hosts (Hostinger temp URL, php -S) stay as-is.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(www\.)?neutralpolitics\.in$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L]

  # Always strip a trailing slash, including real folders such as /hi/.
  RewriteRule ^(.+)/$ /$1 [R=308,L]

  # Preview / temporary hosts must not be indexed (Hostinger *.hostingersite.com, pages.dev, etc.).
  RewriteCond %{HTTP_HOST} !^(www\.)?neutralpolitics\.in$ [NC]
  RewriteRule ^robots\.txt$ robots-preview.txt [L]

  # Search result pages stay noindex even on www (Header looks at NP_SEARCH_NOINDEX).
  RewriteCond %{QUERY_STRING} (^|&)q=
  RewriteRule ^(hi/)?search$ - [E=NP_SEARCH_NOINDEX:1]

  # Hide includes and baked data.
  RewriteRule ^api/_ - [F,L]
  RewriteRule ^admin/_ - [F,L]

  # PHP API (same paths the static forms already post to).
  RewriteRule ^api/error-reports$ api/error-reports.php [L,QSA]
  RewriteRule ^api/reports$ api/reports.php [L,QSA]
  RewriteRule ^api/subscribe$ api/subscribe.php [L,QSA]
  RewriteRule ^api/unsubscribe$ api/unsubscribe.php [L,QSA]
  RewriteRule ^api/contribute/start$ api/contribute/start.php [L,QSA]
  RewriteRule ^api/contribute/complete$ api/contribute/complete.php [L,QSA]
  RewriteRule ^api/admin/login$ api/admin/login.php [L,QSA]
  RewriteRule ^api/admin/logout$ api/admin/logout.php [L,QSA]

  # Read-only desk. The Next admin app is parked at build time, so this is PHP.
  RewriteRule ^admin(?:/.*)?$ admin/index.php [L,QSA]

  # Existing files (css, js, images, already-html paths, php).
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Clean URLs: /news/YYYY/MM/slug -> slug.html or slug/index.html (same for /hi/).
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Unpublished or unknown story URL -> homepage notice (same as functions/_middleware.ts).
  RewriteRule ^news/([0-9]{4})/([0-9]{2})/([^/]+)$ api/unpublished.php?lang=en [L,QSA]
  RewriteRule ^hi/news/([0-9]{4})/([0-9]{2})/([^/]+)$ api/unpublished.php?lang=hi [L,QSA]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml application/rss+xml application/atom+xml
</IfModule>

<IfModule mod_mime.c>
  <Files "opengraph-image">
    ForceType image/png
  </Files>
  AddType image/png opengraph-image
</IfModule>

<IfModule mod_headers.c>
  # Search and /admin stay noindex on every host, including www.
  # Do not set a host-based X-Robots-Tag here. LiteSpeed does not honor
  # SetEnvIf Host + "env=!NP_CANONICAL_HOST", and that rule noindexed production.
  Header always set X-Robots-Tag "noindex, nofollow" env=NP_SEARCH_NOINDEX

  SetEnvIf Request_URI "^/admin" NP_ADMIN_NOINDEX
  Header always set X-Robots-Tag "noindex, nofollow" env=NP_ADMIN_NOINDEX

  Header always set X-Content-Type-Options "nosniff"
  Header unset X-Powered-By

  SetEnvIf Request_URI "^/_next/static/" NP_CACHE_IMMUTABLE
  Header set Cache-Control "public, max-age=31536000, immutable" env=NP_CACHE_IMMUTABLE

  SetEnvIf Request_URI "^/media/" NP_CACHE_MEDIA
  Header set Cache-Control "public, max-age=86400" env=NP_CACHE_MEDIA

  SetEnvIf Request_URI "^/brand/" NP_CACHE_MEDIA
  Header set Cache-Control "public, max-age=86400" env=NP_CACHE_MEDIA

  SetEnvIf Request_URI "^/pagefind/" NP_CACHE_PAGEFIND
  Header set Cache-Control "public, max-age=3600" env=NP_CACHE_PAGEFIND

  SetEnvIf Request_URI "\.(html|xml|txt)$" NP_CACHE_HTML
  SetEnvIf Request_URI "^/$" NP_CACHE_HTML
  Header set Cache-Control "public, max-age=0, must-revalidate" env=NP_CACHE_HTML
</IfModule>

<IfModule mod_authz_core.c>
  <Files "np-config.php">
    Require all denied
  </Files>
  <FilesMatch "^(\.env|.*\.inc\.php)$">
    Require all denied
  </FilesMatch>
</IfModule>
