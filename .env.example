# Public site origin used for canonical URLs, sitemaps, RSS and share links.
# No trailing slash. Leave unset in production: the fallback is
# https://www.neutralpolitics.in. http://localhost:3000 is used only when
# NODE_ENV=development and this variable is unset.
# NEXT_PUBLIC_SITE_URL=https://www.neutralpolitics.in

# --- Supabase (free tier) -------------------------------------------------
# Server-only. Never expose the service role key to the browser.
# See docs/admin-setup.md. Run 0001_init.sql, then 0002_admin_desk.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Defaults to the private bucket name "submissions".
SUPABASE_STORAGE_BUCKET=
# Browser sign-in (Google and Facebook). These are public. See docs/oauth-setup.md.
# Leave empty and the buttons stay disabled with a "Coming soon" label.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cloudflare R2 (only if Supabase is not configured) -------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Admin ----------------------------------------------------------------
# /admin stays closed until all three are set. There is no default password.
# Generate the hash with: node scripts/hash-password.mjs '<password>'
# Do not commit the hash or the password. See docs/admin-setup.md.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Salt for hashing contributor IPs. Use a long random string in production.
IP_HASH_SALT=

# --- Cloudflare Turnstile (optional anti-spam) ----------------------------
# If both are empty, forms still work and Turnstile is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Importer / Hindi translation -----------------------------------------
# none  = write Hindi as untranslated English and keep the article a draft
# http  = POST the article fields to your own translator (see README)
TRANSLATION_PROVIDER=none
TRANSLATION_HTTP_URL=
TRANSLATION_HTTP_KEY=
# Set to false only after the launch review period. While true, every import is a draft.
IMPORT_ALWAYS_DRAFT=true
